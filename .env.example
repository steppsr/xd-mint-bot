# Copy this file to .env and replace every placeholder.
# The bot refuses to start while DISCORD_BOT_TOKEN or the Filebase keys are still placeholders.

# Discord
DISCORD_BOT_TOKEN=your_token_here
# Comma-separated Discord user IDs allowed to react with the seedling and run /nftstatus.
AUTHORIZED_USER_IDS=123456789012345678
# Optional. Set this to sync /nftstatus to one server immediately.
DISCORD_GUILD_ID=
# Optional. Leave empty to accept every server the bot is invited to.
ALLOWED_GUILD_IDS=
# Unicode seedling. For a custom emoji, use its name without colons.
SEEDLING_EMOJI=🌱

# Chia
# mainnet or testnet. Testnet addresses start with txch1.
CHIA_NETWORK=mainnet
CHIA_RPC_HOST=127.0.0.1
CHIA_WALLET_RPC_PORT=9256
# https uses the wallet client certificate. subprocess runs `chia rpc wallet` instead.
CHIA_RPC_MODE=https
CHIA_RPC_TIMEOUT=180
CHIA_EXECUTABLE=chia
# Optional. Example: /home/chia/.chia/mainnet or /home/chia/.chia/testnet11
CHIA_ROOT=
# Leave blank to use CHIA_ROOT or ~/.chia/<network>/config/ssl/wallet/.
CHIA_SSL_CERT=
CHIA_SSL_KEY=
CHIA_SSL_CA=
# Client certificates are always sent. Server certificate verification stays off for the
# self-signed wallet cert. Set true only when CHIA_SSL_CA points at the Chia CA.
CHIA_SSL_VERIFY=false
CHIA_NFT_WALLET_ID=4
# Standard XCH wallet that pays the mint fee. This is usually wallet 1.
CHIA_FEE_WALLET_ID=1
CHIA_DID_ID=did:chia:1yourdid
CHIA_ROYALTY_ADDRESS=xch1yourroyaltyaddress
CHIA_TARGET_ADDRESS=xch1yourtargetaddress
# 615000000 mojos = 0.000615 XCH. Fees above 0.01 XCH require ALLOW_HIGH_FEE=true.
CHIA_FEE_MOJOS=615000000
ALLOW_HIGH_FEE=false

# Filebase IPFS bucket. Use the IPFS endpoint, not the object-storage endpoint.
# IPFS:     https://s3.filebase.com   region us-east-1
# Objects:  https://s3.filebase.io    region auto   (no CIDs; this bot cannot use it)
FILEBASE_ACCESS_KEY=your_access_key
FILEBASE_SECRET_KEY=your_secret_key
FILEBASE_BUCKET=your-ipfs-bucket
FILEBASE_ENDPOINT=https://s3.filebase.com
FILEBASE_REGION=us-east-1
# Origin only. The bot appends /ipfs/<cid>. A value that already ends in /ipfs is also accepted.
# Public gateway, light use: https://ipfs.filebase.io
# Dedicated gateway:         https://<gateway-name>.myfilebase.com
FILEBASE_GATEWAY=https://ipfs.filebase.io

# CHIP-0007 defaults. Royalty is Chia hundredths of a percent: 300 = 3%.
DEFAULT_COLLECTION_ID=6f1b0c3a-8e4d-4f1a-9c2b-1a2b3c4d5e6f
DEFAULT_COLLECTION_NAME=My NFT Collection
DEFAULT_ROYALTY_PERCENTAGE=300
MINTING_TOOL=xd-mint-bot Discord Bot

# true uploads to IPFS and does not call nft_mint_nft.
DRY_RUN=true
UPLOAD_LICENSE=true
# Optional path to a license file. Empty uses the built-in CC0 text.
LICENSE_FILE=
# Also store the gateway URL beside ipfs:// in the NFT URI lists.
INCLUDE_GATEWAY_URIS=true
# true requires a Midjourney-looking message or a user id in MIDJOURNEY_BOT_IDS.
REQUIRE_MIDJOURNEY=false
MIDJOURNEY_BOT_IDS=

# Explorer links. {nft_id} is replaced with the id returned by the wallet.
# MINTGARDEN_NFT_URL=https://mintgarden.io/nfts/{nft_id}
# SPACESCAN_NFT_URL=https://www.spacescan.io/nft/{nft_id}

# Dexie sale offers. Leave the URLs unset to use mainnet or testnet defaults.
# A blank sale price on the mint form skips this.
# Keep OFFER_FEE_MOJOS at 0. A creator fee locks an XCH coin until the offer is taken or cancelled.
# The taker adds a fee when accepting the offer.
# DEXIE_API_URL=https://api.dexie.space/v1
# DEXIE_OFFER_URL=https://dexie.space/offers/{offer_id}
OFFER_FEE_MOJOS=0
# Seconds to wait for the new NFT to show up in the wallet before creating the offer.
# The default is 600. The maximum is 900. A ready NFT returns as soon as the wallet lists it.
# OFFER_WAIT_SECONDS=600

# Saved collections. The first launch copies DEFAULT_COLLECTION_* into this file.
# COLLECTIONS_FILE=data/collections.json
# OFFERS_DIR=data/offers

LOG_LEVEL=INFO
LOG_FILE=logs/xd-mint-bot.log
TEMP_DIR=temp
MAX_IMAGE_BYTES=26214400
SESSION_TIMEOUT_SECONDS=900
REACTION_COOLDOWN_SECONDS=15
KEEP_TEMP_ON_ERROR=false
